  <link name="panda_link8">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.0"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
    </inertial>
  </link>
  <joint name="panda_joint8" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0.107"/>
    <parent link="panda_link7"/>
    <child link="panda_link8"/>
    <axis xyz="0 0 0"/>
  </joint>

  <!-- panda_hand: invisible wrist flange (structural node for TCP/camera/grasptarget);
       gripper mesh removed so HX5 attaches directly to the arm. -->
  <link name="panda_hand">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0.04"/>
      <mass value=".81"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
    </inertial>
  </link>
  <joint name="panda_hand_joint" type="fixed">
    <parent link="panda_link8"/>
    <child link="panda_hand"/>
    <origin rpy="0 0 -0.785398163397" xyz="0 0 0"/>
  </joint>

  <!-- ======================================================
       HX5-D20 Right Hand
       Attached to panda_hand.
       Orientation:
         xyz="0 0 0.058"  (position where finger tips start on panda_hand)
         rpy="3.14159 0 0" (flip 180° around X so fingers point downward)
       ====================================================== -->
  <link name="hx5_d20_right_base">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/hx5_d20_rev2/hx5_d20_right/hx5_d20_base_unit.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="grey"><color rgba="0.2 0.2 0.2 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/hx5_d20_rev2/hx5_d20_right/hx5_d20_base_unit.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="-2.5954623e-03 1.7926275e-03 6.2957652e-02"/>
      <mass value="3.0185182e-01"/>
      <inertia ixx="5.4241294e-04" ixy="9.2340981e-06" ixz="-2.4709097e-06"
               iyy="3.8933294e-04" iyz="-1.6746740e-06" izz="2.1011567e-04"/>
    </inertial>
  </link>
  <!-- joint idx=9 (fixed) -->
  <joint name="hx5_hand_joint" type="fixed">
    <parent link="panda_hand"/>
    <child link="hx5_d20_right_base"/>
    <!-- Rx=0, Ry=-90°, Rz=0 -->
    <origin xyz="0 0 0" rpy="0 -1.57079633 0"/>
  </joint>

  <!-- ============ THUMB ============ -->
  <!-- joint idx=10 -->
  <link name="finger_r_link1">
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="meshes/hx5_d20_rev2/hx5_d20_right/hx5_d20_thumb_mcp.stl" scale="0.001 0.001 0.001"/></geometry><material name="grey"/></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="meshes/hx5_d20_rev2/hx5_d20_right/hx5_d20_thumb_mcp.stl" scale="0.001 0.001 0.001"/></geometry></collision>
