    <origin xyz="-0.0125 0.03493 0.04475" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit velocity="4.8" effort="1000" lower="-1.57" upper="1.57"/>
    <dynamics damping="0.05"/>
  </joint>

  <!-- joint idx=11 -->
