  <link name="panda_link7">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0.08"/>
      <mass value=".2"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
    </inertial>
    <visual>
