    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="meshes/hx5_d20_rev2/hx5_d20_right/hx5_d20_thumb_mcp2.stl" scale="0.001 0.001 0.001"/></geometry></collision>
